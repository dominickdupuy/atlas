# pi-home configuration template.
# Copy to .env (gitignored) and fill in. compose.yaml reads this file.
# Secrets are scoped as narrowly as the provider allows (D19).

# --- Runner core ---
# Adapter profile: dev = stub connectors (no credentials needed), prod = real adapters.
PIHOME_PROFILE=dev
# Bearer token for the HTTP API and dashboard (D16).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PIHOME_API_TOKEN=change-me
# Port the API/dashboard is published on. Dev publishes on loopback only;
# on the Pi, publish on the Tailscale interface instead (D16, compose.yaml comment).
PIHOME_BIND_PORT=8100
# Timezone for cron schedules and the daily budget window.
PIHOME_TZ=America/New_York

# --- MQTT event bus (D6) ---
PIHOME_MQTT_HOST=mosquitto
PIHOME_MQTT_PORT=1883

# --- Budget (section 8: global daily spend ceiling) ---
# USD. The scheduler pauses when the day's ledger reaches this.
PIHOME_DAILY_CEILING_USD=5.00

# --- Anthropic (reasoning tier, v1.4) ---
ANTHROPIC_API_KEY=
# Model used by tier 2/3 jobs.
PIHOME_MODEL=claude-sonnet-5

# --- ntfy (approvals channel, D8) ---
# URL of the ntfy service as reachable FROM THE RUNNER (compose service name).
PIHOME_NTFY_URL=http://ntfy
PIHOME_NTFY_TOPIC=pihome-approvals
# Access token for the runner's ntfy user (see docs/operations.md).
PIHOME_NTFY_TOKEN=
# Base URL of the RUNNER as reachable FROM YOUR PHONE (the Tailscale address on
# the Pi). ntfy action buttons POST approval decisions to this address (D16).
PIHOME_PUBLIC_URL=http://127.0.0.1:8100

# --- Connector credentials (D19: provider-side scoping is the first layer) ---
# GitHub: fine-grained personal access token, READ-ONLY, only the repos it needs.
GITHUB_TOKEN=
# Google Calendar: OAuth client with the READ-ONLY calendar scope until D8
# writes are actually wanted.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Weather (plain HTTP in-process, D19 — Open-Meteo needs no key) ---
PIHOME_WEATHER_LAT=40.7128
PIHOME_WEATHER_LON=-74.0060
