# Secrets — never in the repo (section 8: credential leak)
.env
*.pem
secrets.yaml

# Host-local settings. The deployed tree IS /opt/atlas, so the runtime
# config file sits inside the repo; the template is config.toml.example.
config.toml

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Runtime state (D16: SQLite lives on a data volume, not in git)
*.db
*.db-wal
*.db-shm
data/

# OS noise
.DS_Store
Thumbs.db
