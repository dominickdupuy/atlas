# Brings the compose stack up at boot on the Pi.
# Install: copy to /etc/systemd/system/, adjust WorkingDirectory to the clone
# location, then: systemctl daemon-reload && systemctl enable pihome-compose

[Unit]
Description=pi-home compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/pi/pi-home
ExecStart=/usr/bin/docker compose --profile ha up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
